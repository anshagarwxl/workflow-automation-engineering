<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://example.org/bpmn/project-approval">
  <bpmn:error id="Err_Scan" name="Scanning system failure" errorCode="SCAN_FAIL"/>
  <bpmn:error id="Err_Customs" name="Customs hold unresolved" errorCode="CUSTOMS_HOLD"/>
  <bpmn:error id="Err_Transit" name="Transit failure" errorCode="TRANSIT_FAIL"/>
  <bpmn:message id="Msg_Cancel" name="Shipper cancellation request"/>
  <bpmn:message id="Msg_Docs" name="Customs documents received"/>
  <bpmn:message id="Msg_Arrive" name="Arrival scan received"/>
  <bpmn:message id="Msg_Redeliver" name="Redelivery requested"/>
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_1" name="Logistics &amp; Shipment Exception Management" processRef="Process_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_shp" name="Shipper / Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rcvret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ct" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>t_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cnt1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_att1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_retbook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rejbook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_charge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_ccomp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cnt2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cfee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ct_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_pufail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_pu" name="Pickup Agent">
        <bpmn:flowNodeRef>t_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_pwin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tohub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>t_hubscan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_scanerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_offline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_hm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pjoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_inc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cdoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cdoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_decl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reqdocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_chold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_insp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dmg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_repack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_incj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_haul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_brk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_eta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_r3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>te</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_tf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_tfail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_arr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_arrm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dscan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_retrans</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_del" name="Delivery Agent">
        <bpmn:flowNodeRef>t_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cnt4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_att4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>evg3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_redel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c_3d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rtsd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_rec" name="Recipient">
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_clm" name="Claims Department">
        <bpmn:flowNodeRef>g_clm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_payc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_clrej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_ev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_clnev</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Shipper books a shipment"/>
    <bpmn:exclusiveGateway id="g_in"/>
    <bpmn:userTask id="t_book" name="Create booking &amp; enter shipment details"/>
    <bpmn:businessRuleTask id="t_val" name="Validate address, weight &amp; service level"/>
    <bpmn:exclusiveGateway id="g_ok" name="Booking valid?" default="Flow_005"/>
    <bpmn:scriptTask id="s_cnt1" name="Count correction attempt" scriptFormat="javascript"><bpmn:script>counter = counter + 1;</bpmn:script></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_att1" name="Corrections &lt; 2?" default="Flow_008"/>
    <bpmn:sendTask id="t_retbook" name="Return booking with error list"/>
    <bpmn:endEvent id="e_rejbook" name="Closed: booking rejected"/>
    <bpmn:serviceTask id="t_charge" name="Calculate charges &amp; confirm booking"/>
    <bpmn:boundaryEvent id="b_ccomp" attachedToRef="t_charge"><bpmn:compensateEventDefinition id="b_ccomp_def"/></bpmn:boundaryEvent>
    <bpmn:task id="t_refund" name="Refund charges less cancellation fee" isForCompensation="true"/>
    <bpmn:serviceTask id="t_sched" name="Schedule pickup &amp; assign agent"/>
    <bpmn:userTask id="t_pickup" name="Collect parcel &amp; scan"/>
    <bpmn:boundaryEvent id="b_pwin" name="Pickup window missed" cancelActivity="true" attachedToRef="t_pickup"><bpmn:timerEventDefinition id="b_pwin_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="g_pu" name="Parcel collected?" default="Flow_015"/>
    <bpmn:scriptTask id="s_cnt2" name="Count pickup attempt" scriptFormat="javascript"><bpmn:script>counter = counter + 1;</bpmn:script></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_pat" name="Pickup attempts &lt; 3?" default="Flow_018"/>
    <bpmn:serviceTask id="t_cfee" name="Cancel booking &amp; bill cancellation fee"/>
    <bpmn:intermediateThrowEvent id="ct_comp" name="Undo booking charges"><bpmn:compensateEventDefinition id="ct_comp_def" activityRef="t_charge"/></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e_pufail" name="Closed: cancelled (pickup failed)"/>
    <bpmn:parallelGateway id="g_fork" name="Parcel picked up"/>
    <bpmn:sendTask id="t_notify" name="Notify shipper: picked up, tracking link"/>
    <bpmn:manualTask id="t_tohub" name="Transport parcel to origin hub"/>
    <bpmn:serviceTask id="t_hubscan" name="Scan parcel at origin hub &amp; update tracking"/>
    <bpmn:boundaryEvent id="b_scanerr" name="Scanning system down" attachedToRef="t_hubscan"><bpmn:errorEventDefinition id="b_scanerr_def" errorRef="Err_Scan"/></bpmn:boundaryEvent>
    <bpmn:userTask id="t_offline" name="Log scan manually, sync later"/>
    <bpmn:exclusiveGateway id="g_hm"/>
    <bpmn:parallelGateway id="g_pjoin"/>
    <bpmn:inclusiveGateway id="g_inc" name="Special handling needed?" default="Flow_033"/>
    <bpmn:subProcess id="cust" name="Customs clearance">
      <bpmn:startEvent id="cs"/>
      <bpmn:serviceTask id="t_cdoc" name="Validate customs documents"/>
      <bpmn:exclusiveGateway id="g_cdoc" name="Documents complete?" default="Flow_036"/>
      <bpmn:serviceTask id="t_decl" name="Submit declaration &amp; obtain clearance"/>
      <bpmn:endEvent id="ce" name="Cleared"/>
      <bpmn:sendTask id="t_reqdocs" name="Request missing documents from shipper"/>
      <bpmn:eventBasedGateway id="evg1" name="Wait for" instantiate="false" eventGatewayType="Exclusive"/>
      <bpmn:intermediateCatchEvent id="c_docs" name="Documents received"><bpmn:messageEventDefinition id="c_docs_def" messageRef="Msg_Docs"/></bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="c_wait" name="5 days"><bpmn:timerEventDefinition id="c_wait_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="e_hold" name="Customs hold unresolved"><bpmn:errorEventDefinition id="e_hold_def" errorRef="Err_Customs"/></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_034" sourceRef="cs" targetRef="t_cdoc"/>
      <bpmn:sequenceFlow id="Flow_035" sourceRef="t_cdoc" targetRef="g_cdoc"/>
      <bpmn:sequenceFlow id="Flow_036" name="Yes" sourceRef="g_cdoc" targetRef="t_decl"/>
      <bpmn:sequenceFlow id="Flow_037" name="No" sourceRef="g_cdoc" targetRef="t_reqdocs"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${docsComplete == false}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_038" sourceRef="t_decl" targetRef="ce"/>
      <bpmn:sequenceFlow id="Flow_039" sourceRef="t_reqdocs" targetRef="evg1"/>
      <bpmn:sequenceFlow id="Flow_040" sourceRef="evg1" targetRef="c_docs"/>
      <bpmn:sequenceFlow id="Flow_041" sourceRef="evg1" targetRef="c_wait"/>
      <bpmn:sequenceFlow id="Flow_042" sourceRef="c_docs" targetRef="t_cdoc"/>
      <bpmn:sequenceFlow id="Flow_043" sourceRef="c_wait" targetRef="e_hold"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_chold" name="Customs hold" attachedToRef="cust"><bpmn:errorEventDefinition id="b_chold_def" errorRef="Err_Customs"/></bpmn:boundaryEvent>
    <bpmn:userTask id="t_insp" name="Inspect parcel for damage"/>
    <bpmn:exclusiveGateway id="g_dmg" name="Damage severity?" default="Flow_046"/>
    <bpmn:userTask id="t_repack" name="Repack &amp; annotate condition"/>
    <bpmn:inclusiveGateway id="g_incj"/>
    <bpmn:subProcess id="tr" name="Line-haul transit">
      <bpmn:startEvent id="ts"/>
      <bpmn:manualTask id="t_haul" name="Transport to destination hub"/>
      <bpmn:boundaryEvent id="b_brk" name="Breakdown / capacity" attachedToRef="t_haul"><bpmn:errorEventDefinition id="b_brk_def" errorRef="Err_Transit"/></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="b_eta" name="ETA exceeded" cancelActivity="false" attachedToRef="t_haul"><bpmn:timerEventDefinition id="b_eta_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:userTask id="t_reass" name="Reassign vehicle or re-route"/>
      <bpmn:exclusiveGateway id="g_r3" name="Reassignments &lt; 3?" default="Flow_054"/>
      <bpmn:endEvent id="te"/>
      <bpmn:endEvent id="e_tf" name="Transit failure"><bpmn:errorEventDefinition id="e_tf_def" errorRef="Err_Transit"/></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_050" sourceRef="ts" targetRef="t_haul"/>
      <bpmn:sequenceFlow id="Flow_051" sourceRef="t_haul" targetRef="te"/>
      <bpmn:sequenceFlow id="Flow_052" sourceRef="b_brk" targetRef="t_reass"/>
      <bpmn:sequenceFlow id="Flow_053" sourceRef="t_reass" targetRef="g_r3"/>
      <bpmn:sequenceFlow id="Flow_054" name="Yes" sourceRef="g_r3" targetRef="t_haul"/>
      <bpmn:sequenceFlow id="Flow_055" name="No" sourceRef="g_r3" targetRef="e_tf"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reassignments &gt;= 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_056" sourceRef="b_eta" targetRef="t_delay"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_cancel" name="Shipper cancels after dispatch" attachedToRef="tr"><bpmn:messageEventDefinition id="b_cancel_def" messageRef="Msg_Cancel"/></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_tfail" name="Transit failure" attachedToRef="tr"><bpmn:errorEventDefinition id="b_tfail_def" errorRef="Err_Transit"/></bpmn:boundaryEvent>
    <bpmn:sendTask id="t_delay" name="Notify recipient of delay &amp; new ETA"/>
    <bpmn:endEvent id="e_delay" name="Delay notified"/>
    <bpmn:eventBasedGateway id="evg2" name="Arrival scan?" instantiate="false" eventGatewayType="Exclusive"/>
    <bpmn:intermediateCatchEvent id="c_arr" name="Arrival scan received"><bpmn:messageEventDefinition id="c_arr_def" messageRef="Msg_Arrive"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_48" name="48 h without scan"><bpmn:timerEventDefinition id="c_48_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_trace" name="Trace parcel across hubs"/>
    <bpmn:exclusiveGateway id="g_found" name="Parcel found?" default="Flow_068"/>
    <bpmn:exclusiveGateway id="g_arrm"/>
    <bpmn:serviceTask id="t_dscan" name="Scan at destination hub &amp; update tracking"/>
    <bpmn:userTask id="t_load" name="Sort &amp; hand over to delivery agent"/>
    <bpmn:userTask id="t_deliver" name="Attempt delivery"/>
    <bpmn:exclusiveGateway id="g_present" name="Recipient present?" default="Flow_074"/>
    <bpmn:exclusiveGateway id="g_accept" name="Parcel accepted?" default="Flow_076"/>
    <bpmn:scriptTask id="s_cnt4" name="Count delivery attempt" scriptFormat="javascript"><bpmn:script>counter = counter + 1;</bpmn:script></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_att4" name="Attempts &lt; 3?" default="Flow_080"/>
    <bpmn:sendTask id="t_card" name="Leave notice &amp; message recipient"/>
    <bpmn:eventBasedGateway id="evg3" name="Wait for" instantiate="false" eventGatewayType="Exclusive"/>
    <bpmn:intermediateCatchEvent id="c_redel" name="Redelivery requested"><bpmn:messageEventDefinition id="c_redel_def" messageRef="Msg_Redeliver"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c_3d" name="3 days"><bpmn:timerEventDefinition id="c_3d_def"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_cod" name="Cash on delivery?" default="Flow_087"/>
    <bpmn:userTask id="t_pay" name="Pay cash on delivery"/>
    <bpmn:exclusiveGateway id="g_paid" name="Payment successful?" default="Flow_090"/>
    <bpmn:serviceTask id="t_pod" name="Capture proof of delivery"/>
    <bpmn:serviceTask id="t_close" name="Close shipment &amp; generate invoice"/>
    <bpmn:endEvent id="e_done" name="Shipment delivered &amp; closed"/>
    <bpmn:userTask id="t_stop" name="Stop shipment &amp; hold parcel"/>
    <bpmn:exclusiveGateway id="g_rts"/>
    <bpmn:userTask id="t_rts" name="Arrange return to sender &amp; bill return fee"/>
    <bpmn:manualTask id="t_retrans" name="Return parcel to origin"/>
    <bpmn:userTask id="t_rcvret" name="Receive returned parcel"/>
    <bpmn:endEvent id="e_rts" name="Closed: returned to sender"/>
    <bpmn:exclusiveGateway id="g_clm"/>
    <bpmn:userTask id="t_open" name="Open claim &amp; collect evidence"/>
    <bpmn:userTask id="t_assess" name="Assess claim"/>
    <bpmn:exclusiveGateway id="g_cl" name="Claim decision" default="Flow_102"/>
    <bpmn:serviceTask id="t_payc" name="Pay compensation"/>
    <bpmn:endEvent id="e_claim" name="Closed: claim settled (damaged / lost)"/>
    <bpmn:endEvent id="e_clrej" name="Closed: claim rejected"/>
    <bpmn:scriptTask id="s_ev" name="Count evidence request" scriptFormat="javascript"><bpmn:script>counter = counter + 1;</bpmn:script></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_ev" name="Requests &lt; 2?" default="Flow_107"/>
    <bpmn:endEvent id="e_clnev" name="Closed: claim rejected (no evidence)"/>
    <bpmn:exclusiveGateway id="g_rtsd"/>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="start" targetRef="g_in"/>
    <bpmn:sequenceFlow id="Flow_002" sourceRef="g_in" targetRef="t_book"/>
    <bpmn:sequenceFlow id="Flow_003" sourceRef="t_book" targetRef="t_val"/>
    <bpmn:sequenceFlow id="Flow_004" sourceRef="t_val" targetRef="g_ok"/>
    <bpmn:sequenceFlow id="Flow_005" name="Valid" sourceRef="g_ok" targetRef="t_charge"/>
    <bpmn:sequenceFlow id="Flow_006" name="Invalid" sourceRef="g_ok" targetRef="s_cnt1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${valid == false}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_007" sourceRef="s_cnt1" targetRef="g_att1"/>
    <bpmn:sequenceFlow id="Flow_008" name="Yes" sourceRef="g_att1" targetRef="t_retbook"/>
    <bpmn:sequenceFlow id="Flow_009" name="No" sourceRef="g_att1" targetRef="e_rejbook"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${corrections &gt;= 2}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_010" sourceRef="t_retbook" targetRef="g_in"/>
    <bpmn:sequenceFlow id="Flow_011" sourceRef="t_charge" targetRef="t_sched"/>
    <bpmn:sequenceFlow id="Flow_012" sourceRef="t_sched" targetRef="t_pickup"/>
    <bpmn:sequenceFlow id="Flow_013" sourceRef="b_pwin" targetRef="s_cnt2"/>
    <bpmn:sequenceFlow id="Flow_014" sourceRef="t_pickup" targetRef="g_pu"/>
    <bpmn:sequenceFlow id="Flow_015" name="Collected" sourceRef="g_pu" targetRef="g_fork"/>
    <bpmn:sequenceFlow id="Flow_016" name="Not collected" sourceRef="g_pu" targetRef="s_cnt2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${collected == false}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_017" sourceRef="s_cnt2" targetRef="g_pat"/>
    <bpmn:sequenceFlow id="Flow_018" name="Yes: reschedule" sourceRef="g_pat" targetRef="t_sched"/>
    <bpmn:sequenceFlow id="Flow_019" name="No" sourceRef="g_pat" targetRef="t_cfee"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pickupAttempts &gt;= 3}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_020" sourceRef="t_cfee" targetRef="ct_comp"/>
    <bpmn:sequenceFlow id="Flow_021" sourceRef="ct_comp" targetRef="e_pufail"/>
    <bpmn:sequenceFlow id="Flow_022" sourceRef="g_fork" targetRef="t_notify"/>
    <bpmn:sequenceFlow id="Flow_023" sourceRef="g_fork" targetRef="t_tohub"/>
    <bpmn:sequenceFlow id="Flow_024" sourceRef="t_notify" targetRef="g_pjoin"/>
    <bpmn:sequenceFlow id="Flow_025" sourceRef="t_tohub" targetRef="t_hubscan"/>
