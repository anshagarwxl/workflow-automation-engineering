  <bpmn:process id="Process_1v7vr8b" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="start event">
      <bpmn:outgoing>Flow_0sxj78u</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Activity_07en40x" name="Calculate Total Discount">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="calculate-discounts" resultVariable="totalDiscount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sxj78u</bpmn:incoming>
      <bpmn:outgoing>Flow_0klij5k</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0sxj78u" sourceRef="StartEvent_1" targetRef="Activity_07en40x" />
    <bpmn:scriptTask id="Activity_0qpm4gw" name="Calculate Final Invoice Amount">
      <bpmn:extensionElements>
        <zeebe:script expression="=cartValue * (1 - (totalDiscount / 100))" resultVariable="finalInvoiceAmount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0klij5k</bpmn:incoming>
      <bpmn:outgoing>Flow_1m2hskk</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0klij5k" sourceRef="Activity_07en40x" targetRef="Activity_0qpm4gw" />
