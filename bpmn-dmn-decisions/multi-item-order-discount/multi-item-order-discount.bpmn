    <bpmn:userTask id="Activity_0elr4s7" name="Manager Sign-off">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tz5ond</bpmn:incoming>
      <bpmn:outgoing>Flow_1hzkpdt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0tz5ond" sourceRef="Gateway_0ketma5" targetRef="Activity_0elr4s7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= finalInvoiceAmount &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1i4qvck" name="Send Order to Warehouse">
