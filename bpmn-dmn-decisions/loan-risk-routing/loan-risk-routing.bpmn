  <bpmn:process id="Process_14mssjb" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_1txfl5b</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_00k00tt" name="Route by RIsk">
      <bpmn:incoming>Flow_0t0sfg3</bpmn:incoming>
      <bpmn:outgoing>Flow_1lvc9lk</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rdc29r</bpmn:outgoing>
      <bpmn:outgoing>Flow_1uzt7pz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Activity_1t6jsr1" name="Evaluate Loan Risk">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="evaluate-loan-risk" resultVariable="loanRisk" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1txfl5b</bpmn:incoming>
      <bpmn:outgoing>Flow_0t0sfg3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1txfl5b" sourceRef="StartEvent_1" targetRef="Activity_1t6jsr1" />
    <bpmn:sequenceFlow id="Flow_0t0sfg3" sourceRef="Activity_1t6jsr1" targetRef="Gateway_00k00tt" />
    <bpmn:serviceTask id="Activity_1nazupa" name="Auto-Approve and Disburse">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-approve-and-disburse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lvc9lk</bpmn:incoming>
      <bpmn:outgoing>Flow_0y8w5jv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1lvc9lk" name="LOW" sourceRef="Gateway_00k00tt" targetRef="Activity_1nazupa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">==loanRisk.riskTier = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_12ws8ir" name="Underwriter Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Underwriter Review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rdc29r</bpmn:incoming>
      <bpmn:outgoing>Flow_1k5tdu4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0rdc29r" name="MEDIUM" sourceRef="Gateway_00k00tt" targetRef="Activity_12ws8ir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">==loanRisk.riskTier = "MEDIUM" or loanRisk.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0dq0beg" name="Auto-Reject Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-reject-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1uzt7pz</bpmn:incoming>
      <bpmn:outgoing>Flow_0hzzj67</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1uzt7pz" name="HIGH" sourceRef="Gateway_00k00tt" targetRef="Activity_0dq0beg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">==loanRisk.riskTier = "HIGH" and loanRisk.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1j8kcj6" name="End Event">
      <bpmn:incoming>Flow_0y8w5jv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0y8w5jv" sourceRef="Activity_1nazupa" targetRef="Event_1j8kcj6" />
