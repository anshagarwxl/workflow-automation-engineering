<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_HospitalAppointment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="hospital-appointment-process" name="Hospital Appointment and Triage" isExecutable="true">
    <bpmn:documentation>Lab 3 - Registration validation (job worker), educational DMN triage, mock scheduling API (REST connector), booking request (job worker) and staff review in Tasklist. Synthetic patients only.</bpmn:documentation>
    <bpmn:extensionElements><zeebe:versionTag value="1.0.0" /></bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Appointment request received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="appointment-request" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateRegistration" name="Validate registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="appointment.validate-registration" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RegistrationValid" name="Registration valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Triage" name="Apply triage rules">
      <bpmn:documentation>Educational triage table (not clinical guidance).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="triage-category" resultVariable="triage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_TriageCategory" name="Triage category?" default="Flow_Routine">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Urgent</bpmn:outgoing>
      <bpmn:outgoing>Flow_Priority</bpmn:outgoing>
      <bpmn:outgoing>Flow_Routine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_UrgentAssessment" name="Immediate clinical assessment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="triage-clinicians" />
        <zeebe:priorityDefinition priority="100" />
        <zeebe:formDefinition formId="urgent-assessment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Urgent</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_NotifyUrgent" name="Record urgent assessment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="appointment.notify-patient" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="=&quot;URGENT_ASSESSMENT&quot;" target="notificationType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Urgent" name="Urgent case handled">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_PriorityReview" name="Priority staff review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="triage-nurses" />
        <zeebe:priorityDefinition priority="80" />
        <zeebe:formDefinition formId="priority-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Priority</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PriorityOutcome" name="Review outcome?" default="Flow_Proceed">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Proceed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyReferred" name="Notify: referred to emergency">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="appointment.notify-patient" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="=&quot;REFERRED&quot;" target="notificationType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Refer</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Referred" name="Referred to emergency">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeLookup">
      <bpmn:incoming>Flow_Routine</bpmn:incoming>
      <bpmn:incoming>Flow_Proceed</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RetrieveSlots" name="Retrieve available slots" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11">
      <bpmn:documentation>REST Connector (GET) to the mock scheduling API. HTTP 5xx / timeouts are retried 3 times with a 10 s back-off, then an incident is raised.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="GET" target="method" />
        <zeebe:input source="=(if is defined(mockApiBaseUrl) then mockApiBaseUrl else &quot;http://localhost:8090&quot;) + &quot;/scheduling/api/v1/slots&quot;" target="url" />
        <zeebe:input source="={department: department, date: appointmentDate, session: preferredSession}" target="queryParameters" />
        <zeebe:input source="false" target="storeResponse" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="10" target="readTimeoutInSeconds" />
        <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="elementTemplateVersion" value="11" />
        <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
        <zeebe:header key="resultExpression" value="={availableSlots: response.body.slots, availableSlotCount: response.body.slotCount, slotLookupStatus: &quot;COMPLETED&quot;}" />
        <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SlotAvailable" name="Suitable slot available?" default="Flow_NoSlot">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_SlotFound</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSlot</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RequestBooking" name="Book earliest slot" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="11">
      <bpmn:documentation>REST Connector (POST) to the mock scheduling API. Books the earliest returned slot (availableSlots[1]). HTTP 409 becomes BPMN error SLOT_TAKEN (staff review); HTTP 5xx / timeouts are retried 3 times with a 10 s back-off, then an incident is raised.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="noAuth" target="authentication.type" />
        <zeebe:input source="POST" target="method" />
        <zeebe:input source="=(if is defined(mockApiBaseUrl) then mockApiBaseUrl else &quot;http://localhost:8090&quot;) + &quot;/scheduling/api/v1/bookings&quot;" target="url" />
        <zeebe:input source="false" target="storeResponse" />
        <zeebe:input source="5" target="connectionTimeoutInSeconds" />
        <zeebe:input source="10" target="readTimeoutInSeconds" />
        <zeebe:input source="={slotId: availableSlots[1].slotId, patientRef: patientRef, urgencyCategory: triage.category, requestedBy: &quot;camunda-rest-connector&quot;}" target="body" />
        <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
        <zeebe:header key="elementTemplateVersion" value="11" />
        <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
        <zeebe:header key="resultVariable" value="bookingResponse" />
        <zeebe:header key="resultExpression" value="={bookingStatus: response.body.status, bookingId: response.body.bookingId, appointmentSlotId: response.body.slotId, appointmentDate: response.body.date, appointmentTime: response.body.startTime + &quot;-&quot; + response.body.endTime, doctorCode: response.body.doctorCode}" />
        <zeebe:header key="errorExpression" value="=if error.code = &quot;409&quot; then bpmnError(&quot;SLOT_TAKEN&quot;, &quot;Selected slot is no longer available&quot;, {bookingProblem: &quot;HTTP 409 - slot already booked&quot;}) else null" />
        <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SlotFound</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_SlotTaken" name="Slot taken (HTTP 409)" attachedToRef="Task_RequestBooking">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
        <zeebe:output source="=&quot;SLOT_TAKEN&quot;" target="bookingStatus" />
        <zeebe:output source="=if is defined(bookingProblem) then bookingProblem else &quot;Slot no longer available&quot;" target="bookingProblem" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_SlotTaken</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Boundary_SlotTaken_def" errorRef="Error_SlotTaken" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_NotifyBooked" name="Send appointment confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="appointment.notify-patient" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="=&quot;BOOKING_CONFIRMED&quot;" target="notificationType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Booked" name="Appointment booked">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeManual">
      <bpmn:incoming>Flow_NoSlot</bpmn:incoming>
      <bpmn:incoming>Flow_SlotTaken</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_ManualScheduling" name="Staff review: no suitable slot">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="front-desk-staff" />
        <zeebe:priorityDefinition priority="60" />
        <zeebe:formDefinition formId="manual-scheduling" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_NotifyStaffOutcome" name="Notify patient of next steps">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="appointment.notify-patient" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="=&quot;STAFF_SCHEDULING&quot;" target="notificationType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_StaffHandled" name="Handled by staff">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_NotifyInvalid" name="Notify: registration rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="appointment.notify-patient" retries="3" />
        <zeebe:ioMapping>
        <zeebe:input source="=&quot;REGISTRATION_REJECTED&quot;" target="notificationType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Invalid" name="Registration rejected">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_RequestReceived" targetRef="Task_ValidateRegistration" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ValidateRegistration" targetRef="Gateway_RegistrationValid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Valid" sourceRef="Gateway_RegistrationValid" targetRef="Task_Triage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="Invalid" sourceRef="Gateway_RegistrationValid" targetRef="Task_NotifyInvalid" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Triage" targetRef="Gateway_TriageCategory" />
    <bpmn:sequenceFlow id="Flow_Urgent" name="Urgent assessment" sourceRef="Gateway_TriageCategory" targetRef="UserTask_UrgentAssessment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triage.category = "URGENT_ASSESSMENT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Priority" name="Priority review" sourceRef="Gateway_TriageCategory" targetRef="UserTask_PriorityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=triage.category = "PRIORITY_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Routine" name="Routine" sourceRef="Gateway_TriageCategory" targetRef="Gateway_MergeLookup" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="UserTask_UrgentAssessment" targetRef="Task_NotifyUrgent" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_NotifyUrgent" targetRef="End_Urgent" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="UserTask_PriorityReview" targetRef="Gateway_PriorityOutcome" />
    <bpmn:sequenceFlow id="Flow_Proceed" name="Proceed to booking" sourceRef="Gateway_PriorityOutcome" targetRef="Gateway_MergeLookup" />
    <bpmn:sequenceFlow id="Flow_Refer" name="Refer to emergency" sourceRef="Gateway_PriorityOutcome" targetRef="Task_NotifyReferred">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=priorityReviewOutcome = "REFER_TO_EMERGENCY"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_NotifyReferred" targetRef="End_Referred" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_MergeLookup" targetRef="Task_RetrieveSlots" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_RetrieveSlots" targetRef="Gateway_SlotAvailable" />
    <bpmn:sequenceFlow id="Flow_SlotFound" name="Yes" sourceRef="Gateway_SlotAvailable" targetRef="Task_RequestBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=availableSlotCount &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoSlot" name="No" sourceRef="Gateway_SlotAvailable" targetRef="Gateway_MergeManual" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RequestBooking" targetRef="Task_NotifyBooked" />
    <bpmn:sequenceFlow id="Flow_SlotTaken" sourceRef="Boundary_SlotTaken" targetRef="Gateway_MergeManual" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_NotifyBooked" targetRef="End_Booked" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_MergeManual" targetRef="UserTask_ManualScheduling" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="UserTask_ManualScheduling" targetRef="Task_NotifyStaffOutcome" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_NotifyStaffOutcome" targetRef="End_StaffHandled" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_NotifyInvalid" targetRef="End_Invalid" />
  </bpmn:process>
  <bpmn:error id="Error_SlotTaken" name="Appointment slot taken" errorCode="SLOT_TAKEN" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="hospital-appointment-process">
      <bpmndi:BPMNShape id="StartEvent_RequestReceived_di" bpmnElement="StartEvent_RequestReceived">
        <dc:Bounds x="172" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="140" y="174" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateRegistration_di" bpmnElement="Task_ValidateRegistration">
        <dc:Bounds x="305" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RegistrationValid_di" bpmnElement="Gateway_RegistrationValid" isMarkerVisible="true">
        <dc:Bounds x="495" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="408" y="95" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Triage_di" bpmnElement="Task_Triage">
        <dc:Bounds x="635" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_TriageCategory_di" bpmnElement="Gateway_TriageCategory" isMarkerVisible="true">
        <dc:Bounds x="825" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="738" y="95" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_UrgentAssessment_di" bpmnElement="UserTask_UrgentAssessment">
        <dc:Bounds x="965" y="-25" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyUrgent_di" bpmnElement="Task_NotifyUrgent">
        <dc:Bounds x="1130" y="-25" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Urgent_di" bpmnElement="End_Urgent">
        <dc:Bounds x="1327" y="-3" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1295" y="39" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PriorityReview_di" bpmnElement="UserTask_PriorityReview">
        <dc:Bounds x="965" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PriorityOutcome_di" bpmnElement="Gateway_PriorityOutcome" isMarkerVisible="true">
        <dc:Bounds x="1155" y="260" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1068" y="230" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyReferred_di" bpmnElement="Task_NotifyReferred">
        <dc:Bounds x="1130" y="380" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Referred_di" bpmnElement="End_Referred">
        <dc:Bounds x="1162" y="537" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1130" y="579" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeLookup_di" bpmnElement="Gateway_MergeLookup" isMarkerVisible="true">
        <dc:Bounds x="1155" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RetrieveSlots_di" bpmnElement="Task_RetrieveSlots">
        <dc:Bounds x="1295" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SlotAvailable_di" bpmnElement="Gateway_SlotAvailable" isMarkerVisible="true">
        <dc:Bounds x="1485" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1398" y="95" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestBooking_di" bpmnElement="Task_RequestBooking">
        <dc:Bounds x="1625" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_SlotTaken_di" bpmnElement="Boundary_SlotTaken">
        <dc:Bounds x="1657" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1701" y="204" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyBooked_di" bpmnElement="Task_NotifyBooked">
        <dc:Bounds x="1790" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Booked_di" bpmnElement="End_Booked">
        <dc:Bounds x="1987" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1955" y="174" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeManual_di" bpmnElement="Gateway_MergeManual" isMarkerVisible="true">
        <dc:Bounds x="1650" y="260" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ManualScheduling_di" bpmnElement="UserTask_ManualScheduling">
        <dc:Bounds x="1790" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyStaffOutcome_di" bpmnElement="Task_NotifyStaffOutcome">
        <dc:Bounds x="1955" y="245" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_StaffHandled_di" bpmnElement="End_StaffHandled">
        <dc:Bounds x="2152" y="267" width="36" height="36" />
