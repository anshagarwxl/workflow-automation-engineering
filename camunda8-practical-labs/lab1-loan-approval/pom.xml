<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>edu.srmist.camunda</groupId>
    <artifactId>camunda8-labs</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>lab1-loan-approval</artifactId>
  <name>Lab 1 - Loan approval workers</name>

  <dependencies>
    <dependency>
      <groupId>edu.srmist.camunda</groupId>
      <artifactId>lab-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.camunda</groupId>
      <artifactId>camunda-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- The BPMN/DMN/form files and the scenario files live at the top of the lab folder
         (models/, test-data/) so they are easy to find; they are packaged onto the classpath. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>models</directory>
        <targetPath>models</targetPath>
        <excludes>
          <exclude>dmn-tests/**</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>test-data</directory>
        <targetPath>test-data</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
