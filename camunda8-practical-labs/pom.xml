<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version>
    <relativePath/>
  </parent>

  <groupId>edu.srmist.camunda</groupId>
  <artifactId>camunda8-labs</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Camunda 8 Practical Assignment - Labs 1 to 3</name>

  <modules>
    <module>lab-common</module>
    <module>mock-services</module>
    <module>lab1-loan-approval</module>
    <module>lab2-order-processing</module>
    <module>lab3-hospital-triage</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <!-- Any Camunda 8.8.x client works against a Camunda 8.8+ cluster (Camunda 8 Run or Docker Compose). -->
    <camunda.version>8.8.30</camunda.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.camunda</groupId>
        <artifactId>camunda-spring-boot-starter</artifactId>
        <version>${camunda.version}</version>
      </dependency>
      <dependency>
        <groupId>edu.srmist.camunda</groupId>
        <artifactId>lab-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
