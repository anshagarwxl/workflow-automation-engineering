<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://example.org/bpmn/project-approval" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:error id="Error_NoGuide" name="No eligible guide" errorCode="NO_GUIDE" />
  <bpmn:error id="Error_Notify" name="Record or notification failure" errorCode="NOTIFY_FAIL" />
  <bpmn:message id="Msg_Withdraw" name="Withdrawal notice" />
  <bpmn:message id="Msg_Slot" name="Guide slot released" />
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_1" name="Student Project Approval &#38; Allocation System" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_sys" name="Project Management System">
        <bpmn:flowNodeRef>t_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_att</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_teamrej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_team</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_sim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_subin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_perr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_gui" name="Faculty Guide">
        <bpmn:flowNodeRef>b_wd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_nog</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_com" name="Review Committee (incl. HoD)">
        <bpmn:flowNodeRef>g_evalin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_hod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_rem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_coo" name="Project Coordinator">
        <bpmn:flowNodeRef>t_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_late</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_deadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_escal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_inv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rejmsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_wd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_who</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_twd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mnot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_done2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_stu" name="Student / Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_entry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_revwin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_dead</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Team decides to submit a proposal" />
    <bpmn:exclusiveGateway id="g_entry" />
    <bpmn:userTask id="t_submit" name="Prepare &#38; submit project proposal" />
    <bpmn:userTask id="t_revise" name="Revise proposal per committee comments" />
    <bpmn:endEvent id="e_lapsed" name="Closed: lapsed (no revision)" />
    <bpmn:userTask id="t_late" name="Decide on late-submission request" />
    <bpmn:exclusiveGateway id="g_late" name="Late request approved?" default="Flow_006" />
    <bpmn:endEvent id="e_deadline" name="Closed: deadline missed" />
    <bpmn:userTask id="t_screen" name="Screen proposal (scope, syllabus fit)" />
    <bpmn:userTask id="t_escal" name="Resolve invalid submission manually" />
    <bpmn:endEvent id="e_inv" name="Closed: invalid submission" />
    <bpmn:userTask id="t_match" name="Review similarity match" />
    <bpmn:exclusiveGateway id="g_match" name="Coordinator decision" default="Flow_023" />
    <bpmn:sendTask id="t_mod" name="Request modified topic" />
    <bpmn:exclusiveGateway id="M_rej" />
    <bpmn:sendTask id="t_rejmsg" name="Send rejection reasons to team" />
    <bpmn:exclusiveGateway id="g_new" name="New topic allowed? (first rejection only)" default="Flow_048" />
    <bpmn:endEvent id="e_rej" name="Closed: rejected" />
    <bpmn:userTask id="t_manual" name="Allocate manually: co-guide, external guide or waiting list" />
    <bpmn:exclusiveGateway id="g_man" name="Manual outcome" default="Flow_067" />
    <bpmn:intermediateCatchEvent id="ev_wait" name="Guide slot released">
      <bpmn:messageEventDefinition id="ev_wait_def" messageRef="Msg_Slot" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_wd" name="Record withdrawal &#38; release guide slot" />
    <bpmn:exclusiveGateway id="g_who" name="Who withdrew?" default="Flow_073" />
    <bpmn:endEvent id="e_twd" name="Closed: team withdrew" />
    <bpmn:userTask id="t_mnot" name="Notify team manually &#38; log failure" />
    <bpmn:endEvent id="e_done2" name="Project allocated (manual notice)" />
    <bpmn:exclusiveGateway id="g_evalin" />
    <bpmn:userTask id="t_eval" name="Evaluate proposal" />
    <bpmn:sendTask id="t_remind" name="Send reminder to committee" />
    <bpmn:endEvent id="e_rem" name="Reminder sent" />
    <bpmn:userTask id="t_hod" name="HoD expedites decision" />
    <bpmn:endEvent id="e_hod" name="Escalation handled" />
    <bpmn:exclusiveGateway id="g_dec" name="Committee decision" default="Flow_033" />
    <bpmn:scriptTask id="s_rev" name="Count revision cycle" scriptFormat="javascript">
      <bpmn:script>counter = counter + 1;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_rev" name="Revision cycles &#60; 2?" default="Flow_037" />
    <bpmn:sendTask id="t_revreq" name="Send revision request with comments" />
    <bpmn:userTask id="t_final" name="Issue final decision (approve or reject only)" />
    <bpmn:exclusiveGateway id="g_fin" name="Final decision" default="Flow_042" />
    <bpmn:serviceTask id="t_validate" name="Validate form &#38; team rules" />
    <bpmn:exclusiveGateway id="g_valid" name="Proposal valid?" default="Flow_009" />
    <bpmn:scriptTask id="s_count" name="Count attempt" scriptFormat="javascript">
      <bpmn:script>counter = counter + 1;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_att" name="Attempts left?" default="Flow_014" />
    <bpmn:sendTask id="t_return" name="Return proposal with error list" />
    <bpmn:sendTask id="t_teamrej" name="Notify team: team rule violated" />
    <bpmn:endEvent id="e_team" name="Closed: invalid team" />
    <bpmn:serviceTask id="t_sim" name="Run similarity / duplicate-topic check" />
    <bpmn:exclusiveGateway id="g_sim" name="Similarity above threshold?" default="Flow_021" />
    <bpmn:exclusiveGateway id="g_subin" />
    <bpmn:subProcess id="sub" name="Guide allocation &#38; confirmation">
      <bpmn:startEvent id="si" />
      <bpmn:businessRuleTask id="t_rule" name="Check guide availability, workload &#38; domain match" />
      <bpmn:exclusiveGateway id="g_elig" name="Eligible guide found?" default="Flow_052" />
      <bpmn:serviceTask id="t_alloc" name="Allocate guide" />
      <bpmn:boundaryEvent id="b_comp" attachedToRef="t_alloc">
        <bpmn:compensateEventDefinition id="b_comp_def" />
      </bpmn:boundaryEvent>
      <bpmn:task id="t_release" name="Release guide slot" isForCompensation="true" />
      <bpmn:endEvent id="e_noguide" name="No eligible guide">
        <bpmn:errorEventDefinition id="e_noguide_def" errorRef="Error_NoGuide" />
      </bpmn:endEvent>
      <bpmn:sendTask id="t_req" name="Send allocation request to guide" />
      <bpmn:userTask id="t_resp" name="Review request &#38; accept / decline" />
      <bpmn:boundaryEvent id="b_silent" name="5 days no response" attachedToRef="t_resp">
        <bpmn:timerEventDefinition id="b_silent_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:exclusiveGateway id="g_resp" name="Guide response" default="Flow_057" />
      <bpmn:endEvent id="e_conf" name="Guide confirmed" />
      <bpmn:scriptTask id="s_ex" name="Exclude guide &#38; count attempt" scriptFormat="javascript">
        <bpmn:script>counter = counter + 1;</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:intermediateThrowEvent id="ct" name="Undo allocation">
        <bpmn:compensateEventDefinition id="ct_def" activityRef="t_alloc" />
      </bpmn:intermediateThrowEvent>
      <bpmn:exclusiveGateway id="g_att2" name="Attempts &#60; 3?" default="Flow_062" />
      <bpmn:endEvent id="e_exh" name="Guide attempts exhausted">
        <bpmn:errorEventDefinition id="e_exh_def" errorRef="Error_NoGuide" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_050" sourceRef="si" targetRef="t_rule" />
      <bpmn:sequenceFlow id="Flow_051" sourceRef="t_rule" targetRef="g_elig" />
      <bpmn:sequenceFlow id="Flow_052" name="Yes" sourceRef="g_elig" targetRef="t_alloc" />
      <bpmn:sequenceFlow id="Flow_053" name="No" sourceRef="g_elig" targetRef="e_noguide">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${eligibleGuide == null}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_054" sourceRef="t_alloc" targetRef="t_req" />
      <bpmn:sequenceFlow id="Flow_055" sourceRef="t_req" targetRef="t_resp" />
      <bpmn:sequenceFlow id="Flow_056" sourceRef="t_resp" targetRef="g_resp" />
      <bpmn:sequenceFlow id="Flow_057" name="Accepted" sourceRef="g_resp" targetRef="e_conf" />
      <bpmn:sequenceFlow id="Flow_058" name="Declined" sourceRef="g_resp" targetRef="s_ex">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guideResponse == 'DECLINE'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_059" sourceRef="b_silent" targetRef="s_ex" />
      <bpmn:sequenceFlow id="Flow_060" sourceRef="s_ex" targetRef="ct" />
      <bpmn:sequenceFlow id="Flow_061" sourceRef="ct" targetRef="g_att2" />
      <bpmn:sequenceFlow id="Flow_062" name="Yes: next guide" sourceRef="g_att2" targetRef="t_rule" />
      <bpmn:sequenceFlow id="Flow_063" name="No: 3 attempts used" sourceRef="g_att2" targetRef="e_exh">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guideAttempts &gt;= 3}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:association id="Assoc_1" associationDirection="One" sourceRef="b_comp" targetRef="t_release" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="g_join" />
    <bpmn:subProcess id="P" name="Record allocation &#38; notify">
      <bpmn:startEvent id="ps" />
      <bpmn:serviceTask id="t_rec" name="Record allocation in PMS" />
      <bpmn:boundaryEvent id="b_e1" attachedToRef="t_rec">
        <bpmn:errorEventDefinition id="b_e1_def" errorRef="Error_Notify" />
      </bpmn:boundaryEvent>
      <bpmn:sendTask id="t_not" name="Notify team &#38; guide" />
      <bpmn:boundaryEvent id="b_e2" attachedToRef="t_not">
        <bpmn:errorEventDefinition id="b_e2_def" errorRef="Error_Notify" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="pe" />
      <bpmn:endEvent id="pee" name="Record / notify error">
        <bpmn:errorEventDefinition id="pee_def" errorRef="Error_Notify" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_075" sourceRef="ps" targetRef="t_rec" />
      <bpmn:sequenceFlow id="Flow_076" sourceRef="t_rec" targetRef="t_not" />
      <bpmn:sequenceFlow id="Flow_077" sourceRef="t_not" targetRef="pe" />
      <bpmn:sequenceFlow id="Flow_078" sourceRef="b_e1" targetRef="pee" />
      <bpmn:sequenceFlow id="Flow_079" sourceRef="b_e2" targetRef="pee" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="s_retry" name="Count retry" scriptFormat="javascript">
      <bpmn:script>counter = counter + 1;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="g_retry" name="Retries &#60; 3?" default="Flow_083" />
    <bpmn:endEvent id="e_done" name="Project allocated &#38; student notified" />
    <bpmn:boundaryEvent id="b_perr" name="System failure" attachedToRef="P">
      <bpmn:errorEventDefinition id="b_perr_def" errorRef="Error_Notify" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_wd" name="Withdrawal by team or guide" attachedToRef="sub">
      <bpmn:messageEventDefinition id="b_wd_def" messageRef="Msg_Withdraw" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_nog" name="No guide available" attachedToRef="sub">
      <bpmn:errorEventDefinition id="b_nog_def" errorRef="Error_NoGuide" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_esc" name="10 days" cancelActivity="false" attachedToRef="t_eval">
      <bpmn:timerEventDefinition id="b_esc_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_rem" name="5 days" cancelActivity="false" attachedToRef="t_eval">
      <bpmn:timerEventDefinition id="b_rem_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_revwin" name="7-day revision window" attachedToRef="t_revise">
      <bpmn:timerEventDefinition id="b_revwin_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_dead" name="Deadline passed" attachedToRef="t_submit">
      <bpmn:timerEventDefinition id="b_dead_def">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${submissionDeadline}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_001" sourceRef="start" targetRef="g_entry" />
    <bpmn:sequenceFlow id="Flow_007" name="Yes: extension granted" sourceRef="g_late" targetRef="g_entry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${lateApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_015" sourceRef="t_return" targetRef="g_entry" />
    <bpmn:sequenceFlow id="Flow_025" sourceRef="t_mod" targetRef="g_entry" />
    <bpmn:sequenceFlow id="Flow_040" sourceRef="t_revise" targetRef="g_entry" />
    <bpmn:sequenceFlow id="Flow_047" name="Yes: one new topic" sourceRef="g_new" targetRef="g_entry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rejections == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_002" sourceRef="g_entry" targetRef="t_submit" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="t_submit" targetRef="t_validate" />
    <bpmn:sequenceFlow id="Flow_039" sourceRef="t_revreq" targetRef="t_revise" />
    <bpmn:sequenceFlow id="Flow_044" sourceRef="b_revwin" targetRef="e_lapsed" />
    <bpmn:sequenceFlow id="Flow_004" sourceRef="b_dead" targetRef="t_late" />
    <bpmn:sequenceFlow id="Flow_005" sourceRef="t_late" targetRef="g_late" />
    <bpmn:sequenceFlow id="Flow_006" name="No" sourceRef="g_late" targetRef="e_deadline" />
    <bpmn:sequenceFlow id="Flow_009" name="Valid" sourceRef="g_valid" targetRef="t_screen" />
    <bpmn:sequenceFlow id="Flow_018" sourceRef="t_screen" targetRef="t_sim" />
    <bpmn:sequenceFlow id="Flow_016" name="No: limit reached" sourceRef="g_att" targetRef="t_escal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${attempts &gt;= 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_017" sourceRef="t_escal" targetRef="e_inv" />
    <bpmn:sequenceFlow id="Flow_020" name="Yes: similar" sourceRef="g_sim" targetRef="t_match">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${similarity &gt; threshold}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_022" sourceRef="t_match" targetRef="g_match" />
    <bpmn:sequenceFlow id="Flow_023" name="Acceptable" sourceRef="g_match" targetRef="g_evalin" />
    <bpmn:sequenceFlow id="Flow_024" name="Modify topic" sourceRef="g_match" targetRef="t_mod">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coordDecision == 'MODIFY'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_026" name="Reject: duplicate" sourceRef="g_match" targetRef="M_rej">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coordDecision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_035" name="Rejected" sourceRef="g_dec" targetRef="M_rej">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_043" name="Reject" sourceRef="g_fin" targetRef="M_rej">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finalDecision == 'REJECT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_045" sourceRef="M_rej" targetRef="t_rejmsg" />
    <bpmn:sequenceFlow id="Flow_046" sourceRef="t_rejmsg" targetRef="g_new" />
    <bpmn:sequenceFlow id="Flow_048" name="No" sourceRef="g_new" targetRef="e_rej" />
    <bpmn:sequenceFlow id="Flow_065" sourceRef="b_nog" targetRef="t_manual" />
    <bpmn:sequenceFlow id="Flow_066" sourceRef="t_manual" targetRef="g_man" />
    <bpmn:sequenceFlow id="Flow_067" name="Guide assigned manually" sourceRef="g_man" targetRef="g_join" />
    <bpmn:sequenceFlow id="Flow_068" name="Waiting list" sourceRef="g_man" targetRef="ev_wait">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${manualOutcome == 'WAITLIST'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_069" sourceRef="ev_wait" targetRef="g_subin" />
    <bpmn:sequenceFlow id="Flow_070" sourceRef="b_wd" targetRef="t_wd" />
    <bpmn:sequenceFlow id="Flow_071" sourceRef="t_wd" targetRef="g_who" />
    <bpmn:sequenceFlow id="Flow_072" name="Team" sourceRef="g_who" targetRef="e_twd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${withdrawnBy == 'TEAM'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_073" name="Guide: re-allocate" sourceRef="g_who" targetRef="g_subin" />
    <bpmn:sequenceFlow id="Flow_084" name="No: 3 failures" sourceRef="g_retry" targetRef="t_mnot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retries &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_085" sourceRef="t_mnot" targetRef="e_done2" />
    <bpmn:sequenceFlow id="Flow_021" name="No: original" sourceRef="g_sim" targetRef="g_evalin" />
    <bpmn:sequenceFlow id="Flow_027" sourceRef="g_evalin" targetRef="t_eval" />
    <bpmn:sequenceFlow id="Flow_028" sourceRef="t_eval" targetRef="g_dec" />
    <bpmn:sequenceFlow id="Flow_029" sourceRef="b_rem" targetRef="t_remind" />
    <bpmn:sequenceFlow id="Flow_030" sourceRef="t_remind" targetRef="e_rem" />
    <bpmn:sequenceFlow id="Flow_031" sourceRef="b_esc" targetRef="t_hod" />
    <bpmn:sequenceFlow id="Flow_032" sourceRef="t_hod" targetRef="e_hod" />
    <bpmn:sequenceFlow id="Flow_033" name="Approved" sourceRef="g_dec" targetRef="g_subin" />
    <bpmn:sequenceFlow id="Flow_034" name="Revise" sourceRef="g_dec" targetRef="s_rev">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'REVISE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_036" sourceRef="s_rev" targetRef="g_rev" />
    <bpmn:sequenceFlow id="Flow_037" name="Yes" sourceRef="g_rev" targetRef="t_revreq" />
    <bpmn:sequenceFlow id="Flow_038" name="No: limit reached" sourceRef="g_rev" targetRef="t_final">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${revisions &gt; 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_041" sourceRef="t_final" targetRef="g_fin" />
    <bpmn:sequenceFlow id="Flow_042" name="Approve" sourceRef="g_fin" targetRef="g_subin" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="t_validate" targetRef="g_valid" />
    <bpmn:sequenceFlow id="Flow_010" name="Form errors" sourceRef="g_valid" targetRef="s_count">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorType == 'FORM'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_011" name="Team rule violated" sourceRef="g_valid" targetRef="t_teamrej">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorType == 'TEAM'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_013" sourceRef="s_count" targetRef="g_att" />
    <bpmn:sequenceFlow id="Flow_014" name="Yes: attempt &#60; 2" sourceRef="g_att" targetRef="t_return" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="t_teamrej" targetRef="e_team" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="t_sim" targetRef="g_sim" />
    <bpmn:sequenceFlow id="Flow_049" sourceRef="g_subin" targetRef="sub" />
    <bpmn:sequenceFlow id="Flow_064" sourceRef="sub" targetRef="g_join" />
    <bpmn:sequenceFlow id="Flow_083" name="Yes: retry" sourceRef="g_retry" targetRef="g_join" />
    <bpmn:sequenceFlow id="Flow_074" sourceRef="g_join" targetRef="P" />
    <bpmn:sequenceFlow id="Flow_080" sourceRef="P" targetRef="e_done" />
    <bpmn:sequenceFlow id="Flow_081" sourceRef="b_perr" targetRef="s_retry" />
    <bpmn:sequenceFlow id="Flow_082" sourceRef="s_retry" targetRef="g_retry" />
